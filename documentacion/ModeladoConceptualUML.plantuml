@startuml
skinparam classAttributeIconSize 0


class Centro <<entity>> {
  + Nombre
  + Localidad
  + Provincia
}

class Usuario <<entity>> {
  + Nombre
  + Apellidos
  + DNI
  + Domicilio
  + email
  + contraseña
  + fechaNacimiento
  + cuentaBancaria
}

class Medico <<entity>> {
  + NumeroColegiado
  + Departamento
}

class Agenda <<entity>> {
  + FechaHora
  + NumeroHabitacion
}

enum EstadoCita <<enum>> {
  + Pendiente
  + Realizada
  + Cancelada
}


class Enfermero <<entity>> {
  + NumeroColegiado
}

class Administrativos <<entity>> {
}

class Paciente <<entity>> {
  + FechaDefunción
  + CompañiaSeguro
  + NumeroPoliza
  + GrupoSanguineo
  + Peso
  + Estatura
  + Género
  + Alergias
}



class Cita <<entity>> {
  + Departamento
  + EstadoCita: EstadoCita
}


class Ingreso <<entity>> {
  + DiaHoraAlta
  + Observacion
}

class EnfermedadesDiagnosticadas <<entity>> {
  + NombreEnfermedad
}

class PruebasRealizadas <<entity>> {
  + Nombre
  + FechaHora 
}


'Relaciones

Usuario ^-- Medico
Usuario ^-- Paciente
Usuario ^-- Enfermero
Usuario ^-- Administrativos

Agenda ^-- Cita
Agenda ^-- Ingreso



Medico "*" -- "*" Paciente : EsAtendido



Enfermero "0..*" -- "*" Medico : Apoya
Administrativos "*" -- "*" Enfermero : Administra
Administrativos "*" -- "*" Medico : Administra
Administrativos "*" -- "*" Paciente : Administra

Paciente *-- EnfermedadesDiagnosticadas
Paciente *-- PruebasRealizadas
(Medico, Paciente) .. Agenda


Administrativos "*" -- "*" Agenda : Administra
Centro "*" -- "*" Agenda : SeRealizaEn



Usuario "*" -- "*" Centro : PerteneceA

note top of Agenda
  RN2: Solo está permitido que un paciente 
  pueda tener como máximo tres citas 
  agendadas en su perfil.

end note

note top of Agenda
  RN3: Máximo de un periodo de 3 meses de antelación
   para una cita asignada por parte de un cliente
end note

note left of PruebasRealizadas
  RN1: Si un paciente fallece, que el historial de pruebas
   se borre después de 2 años debido a políticas de la empresa

end note

@enduml
